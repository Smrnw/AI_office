# Скопируйте в .env и поменяйте под себя. Уже заданные переменные окружения важнее файла.

# Папка с данными: config.json (там API-ключи), задачи, история чатов, рабочая папка по умолчанию.
# Если не задана — папка data/ внутри проекта (рекомендуется).
# PIXEL_OFFICE_DIR=D:/OfficeData

# Адрес и порт. Для доступа из сети укажите 0.0.0.0 — тогда обязателен токен ниже.
PIXEL_OFFICE_HOST=127.0.0.1
PIXEL_OFFICE_PORT=8080

# Токен доступа. При запуске не на localhost без него сервер не стартует.
# Открывайте офис по адресу http://адрес:порт/?token=ВАШ_ТОКЕН (дальше запомнится в cookie).
# PIXEL_OFFICE_TOKEN=придумайте-длинную-строку

# Если сервер открывают по имени (например office.lan), перечислите имена через запятую.
# PIXEL_OFFICE_ALLOWED_HOSTS=office.lan

# Сколько запросов к нейросетям одновременно и таймаут одного запроса, секунд.
# PIXEL_OFFICE_LLM_PARALLEL=3
# PIXEL_OFFICE_LLM_TIMEOUT=120

# Ключи можно не хранить в config.json, а задать переменными: <ID_ПРОВАЙДЕРА>_API_KEY
# OPENAI_API_KEY=sk-...
